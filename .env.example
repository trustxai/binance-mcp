# Binance MCP server configuration.
# Copy to .env and fill in. NEVER commit .env.
#
# Create the key in Binance → Account → API Management with:
#   - Enable Reading                      ON
#   - Enable Spot & Margin Trading        ON  (only if you will place orders)
#   - Enable Withdrawals                  OFF (this server never withdraws; keep the key unable to)
#   - Restrict access to trusted IPs      ON  (this machine's IP)
# The server exposes NO withdrawal tool regardless of the key's permissions.

# API key (X-MBX-APIKEY header). Required for account/trading tools; public market data works without it.
BINANCE_API_KEY=

# RECOMMENDED: a "Self-generated" Ed25519 key (Binance has deprecated HMAC keys, and an
# unrestricted HMAC key may only hold "Enable Reading"). Generate the pair, paste the PUBLIC
# key in API Management, and point this at the PRIVATE key PEM. Takes precedence over
# BINANCE_API_SECRET when set.
#   openssl genpkey -algorithm ed25519 -out ~/.config/binance/ed25519.pem
#   openssl pkey -pubout -in ~/.config/binance/ed25519.pem
# BINANCE_PRIVATE_KEY_PATH=~/.config/binance/ed25519.pem
# BINANCE_PRIVATE_KEY_PASSPHRASE=

# Alternative for a "System generated" HMAC key: the secret shown once at creation.
BINANCE_API_SECRET=

# Kill-switch. Leave unset for a read-only server. Set to 1 to allow placing/cancelling
# orders, transfers between wallets, convert acceptQuote, algo orders and dust conversion.
# The order dry-run (POST /api/v3/order/test) always works.
# BINANCE_ALLOW_TRADING=1

# Spot testnet (https://testnet.binance.vision) — use testnet keys. Only /api/v3 exists there;
# wallet/fiat/convert/pay/algo (/sapi) tools return 404 on the testnet.
# BINANCE_TESTNET=1

# REST base URL. Only override for proxies/testing (alternatives: https://api-gcp.binance.com,
# https://api1.binance.com … api4). Overrides the testnet switch when set.
# BINANCE_API_URL=https://api.binance.com

# Signed-request validity window in ms (Binance default 5000, max 60000). Raise on clock drift (-1021).
# BINANCE_RECV_WINDOW_MS=5000

# Per-request timeout in seconds.
# BINANCE_REQUEST_TIMEOUT_SECONDS=30

# Test-suite switch: set to 1 (together with BINANCE_TESTNET=1) to run the mutating `trading` tests.
# BINANCE_TEST_ALLOW_TRADING=
